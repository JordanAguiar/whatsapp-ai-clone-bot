# Chave de API do Gemini (aistudio.google.com → Get API Key)
# NUNCA suba esse arquivo pro GitHub — coloque .env no .gitignore
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: chave da Groq (console.groq.com), usada como IA reserva
# automaticamente se a cota do Gemini acabar. Se deixar em branco, o bot
# funciona só com o Gemini (sem fallback).
GROQ_API_KEY=

# Seu nome exatamente como aparece no seu WhatsApp (usado pra identificar
# suas mensagens dentro do histórico exportado). Ex: MEU_NOME_WHATSAPP=Jordan
MEU_NOME_WHATSAPP=

# Tempo de espera antes do bot responder, em milissegundos (opcional).
# Padrão: 50000-60000 (50 a 60 segundos). Descomente pra customizar.
# DELAY_MIN_MS=50000
# DELAY_MAX_MS=60000
